{
  "compilerOptions": {
    "module": "es6",
    "target": "es6",
    "strict": true,
    "noEmitHelpers": true,
    "noImplicitOverride": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "lib": ["es2017", "dom"],
    "allowSyntheticDefaultImports": true,
    "types": []
  },
  "include": ["./assets", "./src", "./engine"],
  "exclude": ["assets/plugins"]
}
